# ---- Solami (https://solami.dev) --------------------------------------------
# Standard key from Dashboard -> API keys. Used for RPC, WebSocket, Mirage.
SOLAMI_API_KEY=
# Optional: a dedicated gRPC key (Dashboard -> API keys -> gRPC key).
# Falls back to SOLAMI_API_KEY when empty.
SOLAMI_GRPC_KEY=
# Optional region pin: ams | fra | nyc  (empty = nearest / anycast)
SOLAMI_REGION=
# Optional overrides (defaults point at Solami). Set SOLAMI_RPC_URL to any
# public RPC for a keyless smoke test of the RPC transport.
SOLAMI_RPC_URL=
SOLAMI_GRPC_ENDPOINT=
# Only when SOLAMI_GRPC_ENDPOINT points at a local TLS-passthrough proxy (e.g. scripts/chaos_proxy.py):
# the certificate is still grpc.solami.dev, so tell gRPC which name to verify.
SOLAMI_GRPC_TLS_SERVER_NAME=
# Mirage saved-subscription id (Dashboard -> Mirage, or `propguard mirage-create`)
MIRAGE_SUBSCRIPTION_ID=

# ---- What to guard -----------------------------------------------------------
# rpc | grpc | mirage
TRANSPORT=rpc
# Trader wallet (base58). Leave empty and run `propguard demo` to auto-pick
# the largest open Jupiter Perps position on mainnet.
WALLET=
# processed | confirmed
COMMITMENT=processed
# RPC polling interval (only for TRANSPORT=rpc)
POLL_INTERVAL_MS=1500
# Requests per second allowed for your Solami plan (Free=5, Dev=50, Pro=200)
RPC_RPS=5

# ---- Prop-firm rules ---------------------------------------------------------
# Account size used as the base for % limits. 0 = use equity at 00:00 UTC anchor.
ACCOUNT_SIZE_USD=0
# Daily loss limit, % of base (prop firms typically 4-5 %)
DAILY_LOSS_LIMIT_PCT=5
# Max total exposure = sum(position size) / base
MAX_EXPOSURE_X=10
# Liquidation-distance thresholds, % between mark and liquidation price
LIQ_DISTANCE_WARN_PCT=5
LIQ_DISTANCE_CRIT_PCT=2
# Oracle staleness that triggers a health warning, seconds
ORACLE_STALE_SEC=30
# Stream silence that triggers a health warning, seconds
STREAM_STALE_SEC=20

# ---- Alerts ------------------------------------------------------------------
# Bot token from @BotFather and the chat id to deliver to (your user id or a group id).
# Leave both empty for dry-run: the formatted message is logged instead of sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Lowest level delivered to Telegram: info | warn | crit (console always gets everything)
TELEGRAM_MIN_LEVEL=info
# Force dry-run even with a token (1 = log only)
ALERTS_DRY_RUN=0
# Minutes to suppress a repeated alert with the same key+level
ALERT_COOLDOWN_MIN=15

# ---- Stream resilience -------------------------------------------------------
# If the gRPC/Mirage stream delivers no data for this many seconds, RPC polling takes
# over automatically (and hands back as soon as the stream resumes). 0 = disabled.
FALLBACK_SILENCE_SEC=20
FALLBACK_POLL_INTERVAL_MS=2000

# ---- Health journal (optional) -----------------------------------------------
# JSON lines with the stream-health metrics, one record every N seconds. Never contains keys.
HEALTH_LOG_FILE=
HEALTH_LOG_EVERY_SEC=10

# ---- Demo picker -------------------------------------------------------------
# `propguard demo` scans positions touched within the last N hours (getProgramAccountsV2
# with changedSinceSlot on Solami) and guards the largest one that is not about to be liquidated.
DEMO_SCAN_HOURS=24

# ---- Web panel ---------------------------------------------------------------
PANEL_HOST=127.0.0.1
PANEL_PORT=8787

# ---- Persistence -------------------------------------------------------------
STATE_FILE=state/propguard-state.json
LOG_LEVEL=INFO
